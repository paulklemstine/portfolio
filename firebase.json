{
  "hosting": [
    {
      "site": "paulklemstine",
      "public": ".",
      "ignore": [
        "firebase.json",
        ".firebaserc",
        "link_images.sh",
        "docs/**",
        "backup/**",
        "**/.*"
      ],
      "headers": [
        {
          "source": "**/*.@(js|html)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache, no-store, must-revalidate"
            }
          ]
        }
      ]
    },
    {
      "site": "pythagoreancosmos",
      "public": "backup",
      "ignore": [
        "firebase.json",
        ".firebaserc",
        "link_images.sh",
        "**/.*"
      ]
    }
  ]
}
